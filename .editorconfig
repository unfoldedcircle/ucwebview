# The white space rules that scripts/check-whitespace.sh checks (make lint).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,js,mjs,py,sh}]
indent_style = space
indent_size = 4
max_line_length = 120

[Makefile]
indent_style = tab

[*.{md,yml,yaml}]
indent_style = space
indent_size = 2

[webkit-patches/*.patch]
trim_trailing_whitespace = false
